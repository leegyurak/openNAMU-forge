# OpenNamu Forge runtime settings
NAMU_HOST=0.0.0.0
NAMU_PORT=3000
NAMU_LANG=ko-KR
NAMU_MARKUP=namumark
NAMU_GUNICORN_WORKERS=1
NAMU_GUNICORN_THREADS=1
NAMU_THEME_COLOR=#00a495

# Database: sqlite, mysql, postgresql
NAMU_DB_TYPE=postgresql
NAMU_DB=data
NAMU_DB_HOST=opennamu-forge-db
NAMU_DB_PORT=5432
NAMU_DB_USER=opennamu_forge
NAMU_DB_PASSWORD=opennamu_forge_password
NAMU_DB_POOL_PRE_PING=true
NAMU_DB_POOL_SIZE=5
NAMU_DB_MAX_OVERFLOW=10
NAMU_DB_POOL_RECYCLE=3600
NAMU_DB_POOL_TIMEOUT=30

# Prometheus
NAMU_PROMETHEUS_ENABLED=true
NAMU_PROMETHEUS_PATH=/metrics
NAMU_PROMETHEUS_GROUP_BY=endpoint

# Update source
NAMU_UPDATE_REPOSITORY=opennamu-forge/opennamu-forge
